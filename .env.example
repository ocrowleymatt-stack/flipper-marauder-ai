# Copy to .env and fill in what you use. Every value is optional; providers
# without a key are simply not registered with Nexus.

# Cloud model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VENICE_API_KEY=
XAI_API_KEY=

# Local / private model runtimes
OLLAMA_BASE_URL=http://127.0.0.1:11434
FORGE_BASE_URL=

# Remote compute
RUNPOD_API_KEY=

# Local durable state (projects, blobs, jobs, events)
ATLAS_DATA_DIR=./.atlas

# Feature flags: ATLAS_FLAG_<NAME>=on|off, or a JSON file via ATLAS_FLAGS_FILE
# ATLAS_FLAGS_FILE=./atlas.flags.json
