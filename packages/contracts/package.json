{
  "name": "@atlas/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime schemas (zod) and inferred types for the universal Atlas primitives. Depends on nothing else in this repository.",
  "type": "module",
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. --project packages packages/contracts"
  },
  "dependencies": {
    "zod": "^4.6.4"
  }
}
