{
  "name": "atlas-vnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas vNext: contracts, thin Nexus, execution, conversation spine, and architecture-boundary tests.",
  "workspaces": [
    "packages/*",
    "platform/*",
    "dungeons/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx apps/host/src/main.ts",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:boundaries": "vitest run tests/architecture",
    "test:nexus": "vitest run platform/nexus",
    "test:execution": "vitest run platform/execution",
    "test:providers": "vitest run platform/execution/tests",
    "test:runtime": "vitest run platform/execution/tests/runpod-scheduler.test.ts platform/execution/tests/forge.test.ts platform/execution/tests/xai.test.ts",
    "test:persistence": "vitest run platform/persistence/tests platform/jobs/tests/engine.test.ts",
    "test:files": "vitest run platform/storage/tests platform/files/tests platform/context/tests platform/projects/tests",
    "test:compat": "vitest run tests/compat",
    "test:live": "vitest run tests/live",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit && npm run build -w @atlas-vnext/web"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
