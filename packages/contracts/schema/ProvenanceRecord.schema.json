{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.atlas.dev/1.0.0/ProvenanceRecord.schema.json",
  "title": "ProvenanceRecord",
  "x-atlas-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "RFC 4122 UUID."
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$",
      "description": "Version of the Atlas contract surface this record was produced under."
    },
    "projectId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "description": "RFC 4122 UUID."
    },
    "activity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "RFC 4122 UUID."
        },
        "type": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$",
          "description": "What kind of work this was, e.g. `module.step`."
        },
        "jobId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "RFC 4122 UUID."
        },
        "stepId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "description": "RFC 4122 UUID."
        },
        "moduleId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
        },
        "moduleVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$",
          "description": "Semantic version string, e.g. 1.4.2"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "RFC 3339 / ISO 8601 timestamp."
        },
        "endedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "RFC 3339 / ISO 8601 timestamp."
        },
        "parameters": {
          "description": "The declared, non-secret inputs that are not themselves blobs.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "type",
        "jobId",
        "moduleId",
        "moduleVersion",
        "startedAt",
        "endedAt"
      ],
      "additionalProperties": false,
      "description": "The activity node of the inputs -> activity -> outputs triple."
    },
    "agent": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "service",
            "module",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "description": "The actor on whose authority the activity ran."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Multihash-style content address. The only way to name bytes in Atlas."
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "IANA media type of the addressed bytes."
          }
        },
        "required": [
          "address",
          "sizeBytes",
          "mediaType"
        ],
        "additionalProperties": false,
        "description": "A reference to immutable bytes held in content-addressed storage."
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Multihash-style content address. The only way to name bytes in Atlas."
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "IANA media type of the addressed bytes."
          }
        },
        "required": [
          "address",
          "sizeBytes",
          "mediaType"
        ],
        "additionalProperties": false,
        "description": "A reference to immutable bytes held in content-addressed storage."
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "RFC 3339 / ISO 8601 timestamp."
    },
    "attestation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "alg": {
              "type": "string",
              "enum": [
                "sha256",
                "hs256",
                "ed25519"
              ]
            },
            "keyId": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
            },
            "signer": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "service",
                    "module",
                    "system"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false,
              "description": "Who or what caused something to happen."
            },
            "signedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "description": "RFC 3339 / ISO 8601 timestamp."
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "description": "base64url digest or signature over the canonical record."
            }
          },
          "required": [
            "alg",
            "keyId",
            "signer",
            "signedAt",
            "value"
          ],
          "additionalProperties": false,
          "description": "Makes a provenance record independently checkable after the fact."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "contractVersion",
    "projectId",
    "activity",
    "agent",
    "inputs",
    "outputs",
    "recordedAt",
    "attestation"
  ],
  "additionalProperties": false,
  "description": "One edge-set in the provenance graph. Every byte Atlas produces is reachable from one of these."
}
