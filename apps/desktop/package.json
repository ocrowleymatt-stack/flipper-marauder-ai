{
  "name": "@atlas/app-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop shell: packages the web UI with local runtime integration (window, tray, local file access).",
  "type": "module",
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. --project apps apps/desktop"
  }
}
