{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.atlas.dev/1.0.0/JobClaimRequest.schema.json",
  "title": "JobClaimRequest",
  "x-atlas-contract-version": "1.0.0",
  "type": "object",
  "properties": {
    "holder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "leaseDurationMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "jobTypes": {
      "description": "Absent means \"any type\".",
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "holder",
    "leaseDurationMs",
    "limit"
  ],
  "additionalProperties": false,
  "description": "A worker asking the store for work it may exclusively own for a while."
}
