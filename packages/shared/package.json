{
  "name": "@atlas/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Small pure utilities with no I/O: result/error helpers, assertions, string and time helpers.",
  "type": "module",
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. --project packages packages/shared"
  }
}
