{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-vnext.local/schemas/execution-intent.json",
  "title": "ExecutionIntent",
  "description": "Nexus → broker handoff. Contains no adapters, retries, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "correlationId",
    "projectId",
    "capabilityId",
    "chain",
    "policy",
    "input",
    "capabilities"
  ],
  "properties": {
    "correlationId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "capabilityId": { "type": "string", "pattern": "^nexus/[a-z0-9-]+$" },
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localOnly"],
      "properties": {
        "localOnly": { "type": "boolean" },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "retrievalRequired": { "type": "boolean" },
        "posture": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["inline", "cas"] },
        "text": { "type": "string", "maxLength": 16384 },
        "address": { "$ref": "./storage-address.schema.json" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./capability.schema.json" }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["roles"] },
      { "required": ["groups"] },
      { "required": ["retry"] },
      { "required": ["adapters"] }
    ]
  }
}
