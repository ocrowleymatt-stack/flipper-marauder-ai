{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@atlas-vnext/contracts": ["./packages/contracts/src/index.ts"],
      "@atlas-vnext/nexus": ["./platform/nexus/src/index.ts"],
      "@atlas-vnext/execution": ["./platform/execution/src/index.ts"],
      "@atlas-vnext/conversation": ["./platform/conversation/src/index.ts"],
      "@atlas-vnext/events": ["./platform/events/src/index.ts"],
      "@atlas-vnext/persistence": ["./platform/persistence/src/index.ts"],
      "@atlas-vnext/provenance": ["./platform/provenance/src/index.ts"],
      "@atlas-vnext/jobs": ["./platform/jobs/src/index.ts"],
      "@atlas-vnext/permissions": ["./platform/permissions/src/index.ts"],
      "@atlas-vnext/projects": ["./platform/projects/src/index.ts"],
      "@atlas-vnext/observability": ["./platform/observability/src/index.ts"],
      "@atlas-vnext/flags": ["./platform/flags/src/index.ts"],
      "@atlas-vnext/operations": ["./platform/operations/src/index.ts"],
      "@atlas-vnext/storage": ["./platform/storage/src/index.ts"],
      "@atlas-vnext/files": ["./platform/files/src/index.ts"],
      "@atlas-vnext/context": ["./platform/context/src/index.ts"],
      "@atlas-vnext/auth": ["./platform/auth/src/index.ts"],
      "@atlas-vnext/tools": ["./platform/tools/src/index.ts"],
      "@atlas-vnext/plugins": ["./platform/plugins/src/index.ts"],
      "@atlas-vnext/secrets": ["./platform/secrets/src/index.ts"],
      "@atlas-vnext/dungeon-writing": ["./dungeons/writing/src/index.ts"],
      "@atlas-vnext/dungeon-osint": ["./dungeons/osint/src/index.ts"],
      "@atlas-vnext/dungeon-investigation": ["./dungeons/investigation/src/index.ts"],
      "@atlas-vnext/dungeon-research": ["./dungeons/research/src/index.ts"],
      "@atlas-vnext/dungeon-website": ["./dungeons/website/src/index.ts"],
      "@atlas-vnext/dungeon-music": ["./dungeons/music/src/index.ts"],
      "@atlas-vnext/dungeon-privacy": ["./dungeons/privacy/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "platform/**/*.ts",
    "dungeons/**/*.ts",
    "apps/host/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
