{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "layers": {
    "apps": ["@atlas/contracts", "@atlas/plugin-sdk"],
    "nexus": ["@atlas/contracts"],
    "broker": ["@atlas/contracts", "@atlas/plugin-sdk", "@atlas/provider-spi", "@atlas/storage"],
    "edge": ["@atlas/contracts"],
    "packages": [],
    "domains": ["@atlas/contracts", "@atlas/plugin-sdk"]
  },
  "rules": {
    "nexusForbiddenDependencies": [
      "@atlas/broker",
      "@atlas/storage",
      "@atlas/provider-spi"
    ],
    "nexusForbiddenImportFragments": [
      "/domains/",
      "/services/broker/",
      "/packages/storage/",
      "openai",
      "anthropic",
      "gemini",
      "ollama"
    ],
    "domainAllowedDependencies": [
      "@atlas/contracts",
      "@atlas/plugin-sdk"
    ],
    "domainForbiddenImportFragments": [
      "/domains/",
      "/services/",
      "/packages/storage/"
    ]
  }
}
