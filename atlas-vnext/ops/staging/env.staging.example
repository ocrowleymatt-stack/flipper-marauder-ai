# Copy to a host-local file that is NEVER committed, e.g. /etc/atlas-vnext-staging/staging.env
# Do not reuse /etc/atlas/atlas.env. Do not copy production secrets.

# Exact git SHA of the tree you built. Required.
ATLAS_SOURCE_SHA=
ATLAS_BUILD_ID=
ATLAS_STAGING_PG_PASSWORD=replace-with-a-long-random-password
ATLAS_SESSION_SECRET=replace-with-a-long-random-secret
# Browser origin that will load the UI. Must match exactly. Tunnel default:
ATLAS_ALLOWED_ORIGINS=http://127.0.0.1:8788
ATLAS_STAGING_BIND=127.0.0.1

# Leave empty to use live providers when keys are present. Set to 1 only for fixture-only UI.
# ATLAS_USE_MOCK_PROVIDERS=1

# Optional live providers. Missing keys mark that provider unavailable; they do not crash staging.
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
