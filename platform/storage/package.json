{
  "name": "@atlas/platform-storage",
  "version": "0.0.0",
  "private": true,
  "description": "Content-addressed storage: blobs keyed by sha256 digest and `Manifest` trees, with local and remote backends.",
  "type": "module",
  "exports": {
    ".": {
      "atlas-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --root ../.. --project platform platform/storage"
  }
}
